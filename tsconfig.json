{
  // Solo los alias @blackpink/* para el editor. No compila nada por sí mismo:
  // cada paquete tiene su propio tsconfig. Por eso `files: []`.
  "extends": "./shared/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@blackpink/types": ["./shared/types/src/index.ts"],
      "@blackpink/types/*": ["./shared/types/src/*"],
      "@blackpink/ui": ["./shared/ui/src/index.ts"],
      "@blackpink/ui/*": ["./shared/ui/src/*"]
    }
  },
  "files": [],
  "exclude": ["node_modules", "**/dist", "**/.next", "**/.turbo"]
}
