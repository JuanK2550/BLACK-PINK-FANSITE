{
  "name": "@blackpink/content-service",
  "version": "0.1.0",
  "private": true,
  "description": "Miembros, albumes, canciones, cronologia y curiosidades",
  "main": "dist/main.js",
  "files": [
    "dist",
    "prisma/generated",
    "prisma/schema.prisma",
    "prisma/migrations"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.prisma.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:orphans": "tsx prisma/check-orphans.ts",
    "clean": "rimraf dist .turbo",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@blackpink/service-core": "workspace:*",
    "@blackpink/types": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "^8.23.0",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@blackpink/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "^1.16.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "rimraf": "^6.0.1",
    "supertest": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  }
}
