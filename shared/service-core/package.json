{
  "name": "@blackpink/service-core",
  "version": "0.1.0",
  "private": true,
  "description": "Piezas comunes a todos los microservicios NestJS: envelope, errores, cache, logging y Swagger",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@blackpink/types": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/swagger": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@blackpink/config": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "eslint": "^9.17.0",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rimraf": "^6.0.1",
    "rxjs": "catalog:",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
