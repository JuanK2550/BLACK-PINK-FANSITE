{
  "name": "blackpink-fansite",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio de fans no oficial de BLACKPINK. No afiliado a YG Entertainment ni a BLACKPINK.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "check:contrast": "node shared/config/scripts/check-contrast.mjs",
    "check:gallery": "node infra/scripts/commons-gallery.mjs --check",
    "check:spotify": "node infra/scripts/check-spotify.mjs",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "db:backup": "node infra/scripts/db-backup.mjs",
    "db:migrate": "turbo run db:migrate",
    "db:reset": "node infra/scripts/db-reset.mjs",
    "db:seed": "turbo run db:seed",
    "dev": "turbo run dev",
    "dev:services": "turbo run dev --filter=./backend/*",
    "dev:web": "turbo run dev --filter=@blackpink/web",
    "docker:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "docker:down:deps": "docker compose --env-file .env -f infra/docker-compose.deps.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "docker:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --build",
    "docker:up:deps": "docker compose --env-file .env -f infra/docker-compose.deps.yml up -d",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky || true",
    "release:dry": "semantic-release --dry-run --no-ci",
    "setup": "node infra/scripts/setup-env.mjs",
    "test": "turbo run test",
    "test:a11y": "playwright test --config e2e/playwright.config.ts accesibilidad.spec.ts",
    "test:coverage": "pnpm --filter @blackpink/web test:coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@blackpink/config": "workspace:*",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.63.0",
    "@prisma/adapter-pg": "7.10.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.9",
    "sharp": "catalog:",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./frontend/src/styles/globals.css"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write --ignore-path .prettierignore --no-error-on-unmatched-pattern"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "scope": "deps",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": false
            },
            {
              "type": "test",
              "release": false
            },
            {
              "type": "ci",
              "release": false
            },
            {
              "type": "chore",
              "scope": "release",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Novedades"
              },
              {
                "type": "fix",
                "section": "Correcciones"
              },
              {
                "type": "perf",
                "section": "Rendimiento"
              },
              {
                "type": "refactor",
                "section": "Reorganización"
              },
              {
                "type": "chore",
                "scope": "deps",
                "section": "Dependencias"
              },
              {
                "type": "docs",
                "hidden": true
              },
              {
                "type": "test",
                "hidden": true
              },
              {
                "type": "ci",
                "hidden": true
              },
              {
                "type": "chore",
                "hidden": true
              },
              {
                "type": "style",
                "hidden": true
              }
            ]
          }
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md",
          "changelogTitle": "# Registro de cambios"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-enum": [
        2,
        "always",
        [
          "web",
          "gateway",
          "content",
          "media",
          "chatbot",
          "speech",
          "ui",
          "types",
          "config",
          "infra",
          "ci",
          "deps",
          "repo",
          "release"
        ]
      ],
      "subject-case": [
        0
      ]
    }
  }
}
