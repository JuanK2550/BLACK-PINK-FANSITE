# =============================================================================
#  BLACKPINK FANSITE - Variables de entorno
# =============================================================================
#  Copia este fichero a `.env` en la raiz del monorepo:  pnpm setup
#  El `.env` de la raiz lo leen los 5 microservicios (via @nestjs/config) y
#  tambien apps/web (via process.loadEnvFile en next.config.ts).
#  NUNCA subas el `.env` al repositorio. Solo se versiona este `.env.example`.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. GENERAL
# -----------------------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=debug
# Idiomas soportados por todo el sistema (contenido, chatbot y transcripcion)
SUPPORTED_LOCALES=es,en,ko
DEFAULT_LOCALE=es


# -----------------------------------------------------------------------------
# 2. POSTGRESQL
# -----------------------------------------------------------------------------
# Credenciales del contenedor local (infra/docker-compose.yml). En produccion
# (Neon / Supabase) solo se usan las DATABASE_URL_* de abajo.
POSTGRES_USER=blackpink
POSTGRES_PASSWORD=blackpink_dev_password
POSTGRES_DB=blackpink
# Si ya tienes un PostgreSQL instalado en la maquina, el 5432 estara ocupado y
# el contenedor no podra arrancar. En ese caso cambia este puerto (por ejemplo
# a 5433) y actualiza tambien el puerto de las tres DATABASE_URL_* de abajo.
POSTGRES_PORT=5432

# Una URL por servicio. Misma base de datos, un schema de Postgres por servicio:
# cada servicio es dueno de su schema y de sus propias migraciones Prisma.
DATABASE_URL_CONTENT=postgresql://blackpink:blackpink_dev_password@localhost:5432/blackpink?schema=content
DATABASE_URL_MEDIA=postgresql://blackpink:blackpink_dev_password@localhost:5432/blackpink?schema=media
DATABASE_URL_CHAT=postgresql://blackpink:blackpink_dev_password@localhost:5432/blackpink?schema=chat

# Conexion sin pooler, obligatoria en Neon/Supabase para prisma migrate.
# En local puede quedar vacia o apuntar a la misma URL.
DIRECT_URL_CONTENT=
DIRECT_URL_MEDIA=
DIRECT_URL_CHAT=


# -----------------------------------------------------------------------------
# 3. REDIS  (cache, rate limiting, memoria corta del chat, pub/sub de reindexado)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# 4. SEGURIDAD INTERNA
# -----------------------------------------------------------------------------
# Secreto compartido en la cabecera x-internal-key:  web -> gateway -> servicios.
# Generalo con:  node -e "console.log(crypto.randomBytes(48).toString('hex'))"
INTERNAL_API_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio


# -----------------------------------------------------------------------------
# 5. PUERTOS Y URLS DE LOS SERVICIOS
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=4000
CONTENT_SERVICE_PORT=4001
MEDIA_SERVICE_PORT=4002
CHATBOT_SERVICE_PORT=4003
SPEECH_SERVICE_PORT=4004

# URLs que usa el gateway para hablar con cada microservicio.
# En docker-compose se sobreescriben por el nombre del servicio.
CONTENT_SERVICE_URL=http://localhost:4001

# Tiempo maximo de espera de una llamada entre servicios, en milisegundos.
# Sin limite, una dependencia colgada arrastra consigo a quien la llama:
# las esperas se acumulan hasta agotar el servicio. Un fallo aguas arriba
# tiene que fallar rapido.
UPSTREAM_TIMEOUT_MS=4000
# Reintentos del gateway ante fallo de red o 5xx. Nunca ante un 4xx.
UPSTREAM_RETRIES=2
# Cuanto se guarda la copia de respaldo que el gateway sirve cuando un
# servicio esta caido. Muy alta a proposito: un dato de ayer vale mas que un
# error, y la respuesta va marcada con la cabecera x-gateway-stale.
UPSTREAM_STALE_TTL_SECONDS=86400
# Tamano maximo del cuerpo aceptado por el gateway.
BODY_LIMIT=64kb
MEDIA_SERVICE_URL=http://localhost:4002
CHATBOT_SERVICE_URL=http://localhost:4003
SPEECH_SERVICE_URL=http://localhost:4004


# -----------------------------------------------------------------------------
# 6. API GATEWAY  (BFF: CORS, cache, rate limiting)
# -----------------------------------------------------------------------------
# Origenes permitidos, separados por comas
ALLOWED_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=300
# Ventana en segundos y numero maximo de peticiones por ventana e IP
# Ventana del limitador, en MILISEGUNDOS (lo que espera @nestjs/throttler).
RATE_LIMIT_WINDOW_MS=60000
# Limite general por IP dentro de esa ventana.
RATE_LIMIT_MAX=100
# Limite estricto para endpoints costosos (busqueda y quiz): no se cachean y
# cada llamada cuesta varias consultas.
RATE_LIMIT_EXPENSIVE_MAX=20
RATE_LIMIT_CHAT_MAX=15
RATE_LIMIT_SPEECH_MAX=5


# -----------------------------------------------------------------------------
# 7. FRONTEND  (apps/web)
# -----------------------------------------------------------------------------
# Las NEXT_PUBLIC_* viajan al navegador: no pongas secretos aqui.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_QUIZ=true
NEXT_PUBLIC_ENABLE_SPEECH=true
# Dominio del CDN donde subiras tus propias imagenes (next.config -> remotePatterns)
NEXT_PUBLIC_UPLOAD_CDN_URL=

# Solo servidor (Route Handlers y React Server Components). Sin prefijo NEXT_PUBLIC_.
API_GATEWAY_URL=http://localhost:4000
# Secreto para revalidacion ISR bajo demanda cuando cambia el contenido
REVALIDATE_SECRET=cambia-esto-tambien


# -----------------------------------------------------------------------------
# 8. CHATBOT SERVICE  (RAG + guardrails)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo por defecto. Alternativa mas barata: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=2048

# Anthropic no expone endpoint de embeddings: el proveedor se elige en la Fase 7
# y queda detras de una interfaz para poder cambiarlo sin tocar el resto.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Debe coincidir con la dimension de la columna vector(n) de pgvector
EMBEDDING_DIMENSIONS=1024

# Recuperacion: k fragmentos y umbral minimo de similitud.
# Por debajo del umbral el bot responde que no lo sabe en vez de inventar.
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
CHAT_MAX_INPUT_CHARS=800
CHAT_HISTORY_TURNS=6
CHAT_SESSION_TTL=3600


# -----------------------------------------------------------------------------
# 9. SPEECH SERVICE  (transcripcion; el audio nunca se persiste)
# -----------------------------------------------------------------------------
# Claude no acepta audio como entrada: hace falta un proveedor ASR aparte.
# local | deepgram | assemblyai | openai-whisper
ASR_PROVIDER=local
ASR_API_KEY=
ASR_MODEL=
MAX_AUDIO_MB=10
MAX_AUDIO_SECONDS=60
ALLOWED_AUDIO_MIME=audio/webm,audio/mp4,audio/mpeg,audio/wav
ASR_LANGUAGE_HINTS=es,en,ko


# -----------------------------------------------------------------------------
# 10. MEDIA SERVICE  (SOLO metadatos y embeds oficiales)
# -----------------------------------------------------------------------------
# Estas claves sirven unicamente para leer metadatos publicos (titulo, portada,
# duracion). El sitio NUNCA aloja ni sirve audio o video con copyright:
# la reproduccion ocurre siempre dentro del iframe oficial de Spotify / YouTube.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=


# -----------------------------------------------------------------------------
# 11. CI/CD  (en local no hace falta; en GitHub van como Secrets del repo)
# -----------------------------------------------------------------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# RAILWAY_TOKEN=
# RENDER_DEPLOY_HOOK_URL=
# GHCR_TOKEN=
# TURBO_TOKEN=
# TURBO_TEAM=

# ---------------------------------------------------------------------------
# 8. CHATBOT (PINKY) — Google AI Studio / Gemini
# ---------------------------------------------------------------------------
# Clave de Google AI Studio. NUNCA llega al navegador: solo la usa
# chatbot-service en el servidor. Como obtenerla: README, "Chatbot PINKY".
GOOGLE_AI_API_KEY=
# Modelo de chat. Cualquier Flash del plan gratuito sirve.
# gemini-3.5-flash-lite: no gasta tokens en razonar (los de razonamiento
# cuentan contra el limite de salida y cortaban las respuestas largas) y
# aguanta mejor la demanda del plan gratuito.
GOOGLE_AI_CHAT_MODEL=gemini-3.5-flash-lite
# Modelo de embeddings. text-embedding-004 quedo descontinuado en enero de 2026.
GOOGLE_AI_EMBEDDING_MODEL=gemini-embedding-001
# Dimension del vector. 768 a proposito: ver README.
GOOGLE_AI_EMBEDDING_DIM=768
GROQ_API_KEY=

# --- Transcripcion de voz (Fase 11) ------------------------------------------
# Proveedor: `groq` u `openai`. Los dos exponen el MISMO endpoint compatible
# con OpenAI, asi que cambiar de uno a otro es cambiar estas tres variables.
WHISPER_PROVIDER=groq
# whisper-large-v3 o whisper-large-v3-turbo.
#
# Se eligio large-v3 midiendo los dos, no por defecto. Turbo es ~1.7x mas
# rapido con audio limpio (512ms frente a 855ms en una muestra de 4.2s), pero
# esos 340ms no los nota nadie: detras viene la respuesta del chat, que tarda
# segundos. Con ruido los dos se degradan por igual. Lo que decide es lo que
# NO se pudo medir aqui -turbo es un modelo destilado y su punto debil
# documentado son los idiomas no ingleses-, y el sitio tiene coreano. Ante una
# diferencia imperceptible en velocidad y un riesgo real en calidad, gana la
# calidad. Cambiar de modelo es cambiar esta linea.
WHISPER_MODEL=whisper-large-v3
# 10 transcripciones cada 10 minutos por IP. NO es la cuota de Groq: esa la
# pone Groq, es por ORGANIZACION y no por clave, y se agota aunque nadie abuse.
SPEECH_RATE_WINDOW_MS=600000
SPEECH_RATE_MAX=10