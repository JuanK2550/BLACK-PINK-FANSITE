{
  "name": "@blackpink/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Puerta de entrada unica (BFF): enruta, cachea y aplica rate limiting",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@blackpink/service-core": "workspace:*",
    "@blackpink/types": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "compression": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@blackpink/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "^1.16.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "supertest": "catalog:",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.8 || ^3.0.0"
  }
