{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blackpink/config/tsconfig/base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["prisma/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "prisma/generated"]
}
