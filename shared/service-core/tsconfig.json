{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blackpink/config/tsconfig/nestjs.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // A diferencia de un servicio, esto es una libreria: los servicios que la
    // consumen necesitan sus .d.ts.
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".turbo", "**/*.test.ts"]
}
