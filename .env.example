# Variables de entorno. Copia este fichero a `.env` con `pnpm setup`.
# El `.env` lo leen los 5 servicios y la web. Nunca lo subas al repositorio.

# --- General ------------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=debug
# Proxies delante de cada servicio. En Railway y Render: 1. En local, vacío.
TRUST_PROXY=

# --- PostgreSQL ---------------------------------------------------------------
# Credenciales del contenedor local. Si el 5432 está ocupado, cambia el puerto
# aquí y en las DATABASE_URL de abajo.
POSTGRES_USER=blackpink
POSTGRES_PASSWORD=blackpink_dev_password
POSTGRES_DB=blackpink
POSTGRES_PORT=5432

# Una base, un esquema por servicio.
DATABASE_URL_CONTENT=postgresql://blackpink:blackpink_dev_password@localhost:5432/blackpink?schema=content
DATABASE_URL_CHAT=postgresql://blackpink:blackpink_dev_password@localhost:5432/blackpink?schema=chat
# Conexión directa (sin pooler) para las migraciones en producción. En local, vacía.
DIRECT_URL_CONTENT=

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Seguridad interna --------------------------------------------------------
# Secreto entre la web, el gateway y los servicios. Mínimo 24 caracteres.
# Genéralo con: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
INTERNAL_API_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Puertos y direcciones de los servicios ------------------------------------
API_GATEWAY_PORT=4000
CONTENT_SERVICE_PORT=4001
MEDIA_SERVICE_PORT=4002
CHATBOT_SERVICE_PORT=4003
SPEECH_SERVICE_PORT=4004

CONTENT_SERVICE_URL=http://localhost:4001
MEDIA_SERVICE_URL=http://localhost:4002
CHATBOT_SERVICE_URL=http://localhost:4003
SPEECH_SERVICE_URL=http://localhost:4004

# --- Gateway ------------------------------------------------------------------
# Orígenes permitidos (CORS), separados por comas.
ALLOWED_ORIGINS=http://localhost:3000
# Espera máxima y reintentos al llamar a un servicio.
UPSTREAM_TIMEOUT_MS=4000
UPSTREAM_RETRIES=2
# Cuánto se guarda la copia de respaldo que se sirve si un servicio cae.
UPSTREAM_STALE_TTL_SECONDS=86400
BODY_LIMIT=64kb
# Caché de las respuestas, en segundos.
CACHE_TTL_SECONDS=300
# Límite de peticiones por IP (ventana en milisegundos).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Límite para búsqueda y quiz, que no se cachean.
RATE_LIMIT_EXPENSIVE_MAX=20

# --- Web ----------------------------------------------------------------------
# Las NEXT_PUBLIC_* llegan al navegador: nunca pongas secretos en ellas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dirección pública del gateway (la que usa el navegador).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dominio de un CDN para imágenes propias (opcional).
NEXT_PUBLIC_UPLOAD_CDN_URL=
# Dirección del gateway desde el servidor de la web.
API_GATEWAY_URL=http://localhost:4000
# Secreto del endpoint de revalidación. Mínimo 24 caracteres: el de ejemplo no vale a propósito.
REVALIDATE_SECRET=cambia-esto-tambien
# Código de la etiqueta meta de Google Search Console (opcional si verificas por DNS).
GOOGLE_SITE_VERIFICATION=

# --- Errores (Sentry, opcional) -------------------------------------------------
# Vacío = desactivado. SENTRY_DSN es de los servicios; el de la web es público por diseño.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_DSN=
# Solo en Vercel, para subir los source maps al compilar.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Chatbot (PINKY) con Google Gemini -----------------------------------------
# Clave de Google AI Studio. Solo la usa el servidor.
GOOGLE_AI_API_KEY=
GOOGLE_AI_CHAT_MODEL=gemini-3.5-flash-lite
GOOGLE_AI_EMBEDDING_MODEL=gemini-embedding-001
# Tiene que coincidir con la columna vector(768) de la base.
GOOGLE_AI_EMBEDDING_DIM=768

# --- Voz (transcripción con Whisper) --------------------------------------------
# groq u openai: los dos usan la misma API.
WHISPER_PROVIDER=groq
WHISPER_MODEL=whisper-large-v3
GROQ_API_KEY=
OPENAI_API_KEY=
# Tamaño y duración máximos del audio.
MAX_AUDIO_MB=10
MAX_AUDIO_SECONDS=60
# Límite de transcripciones por IP: 10 cada 10 minutos.
SPEECH_RATE_WINDOW_MS=600000
SPEECH_RATE_MAX=10

# --- Spotify (solo scripts de infra/, para identificadores y portadas) -----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
