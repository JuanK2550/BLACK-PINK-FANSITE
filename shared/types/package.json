{
  "name": "@blackpink/types",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos e interfaces compartidos entre el frontend y los microservicios",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@blackpink/config": "workspace:*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
