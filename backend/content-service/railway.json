{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/content-service/Dockerfile",
    "watchPatterns": [
      "/backend/content-service/**",
      "/shared/service-core/**",
      "/shared/types/**",
      "/shared/config/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["node node_modules/prisma/build/index.js migrate deploy"],
    "healthcheckPath": "/health/db",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
