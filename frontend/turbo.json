{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "env": [
        "API_GATEWAY_URL",
        "GOOGLE_SITE_VERIFICATION",
        "VERCEL",
        "VERCEL_ANALYTICS",
        "VERCEL_ENV",
        "VERCEL_SPEED_INSIGHTS"
      ],
      "passThroughEnv": [
        "REVALIDATE_SECRET",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VERCEL_URL"
      ]
    }
  }
}
