{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/es",
        "http://localhost:3000/es/integrantes",
        "http://localhost:3000/es/discografia/born-pink",
        "http://localhost:3000/es/galeria",
        "http://localhost:3000/es/quiz",
        "http://localhost:3000/ko"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-informes/movil"
    }
  }
}
